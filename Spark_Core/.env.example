# Local development environment configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Database URLs
DATABASE_URL=postgresql://spark_app:spark_app_local_only@127.0.0.1:5432/spark
MIGRATION_DATABASE_URL=postgresql://spark_migrator:spark_migrate_local_only@127.0.0.1:5432/spark
AUTH_DATABASE_URL=postgresql://spark_auth:spark_auth_local_only@127.0.0.1:5432/spark
# Auth process (src/auth-server.ts): the only holder of AUTH_DATABASE_URL.
# Locally both processes read this file; in deployment give each service only its own secrets.
AUTH_HOST=127.0.0.1
AUTH_PORT=4100
AUTH_SERVICE_URL=http://127.0.0.1:4100
# Production: the API hosts allowed to set X-Forwarded-For on the auth process (local default: loopback).
# AUTH_TRUSTED_PROXIES=10.0.0.5

# Redis
REDIS_URL=redis://127.0.0.1:6379

# CORS Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
