# Local development only. Replace every credential outside local Compose.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
TRUSTED_PROXIES=
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

DATABASE_URL=postgresql://spark_app:spark_app_local_only@127.0.0.1:5432/spark
MIGRATION_DATABASE_URL=postgresql://spark_migrator:spark_migrate_local_only@127.0.0.1:5432/spark
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:56379
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

SPARK_REDIS_PORT=56379
